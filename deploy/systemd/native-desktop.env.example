# systemd EnvironmentFile syntax; use literal absolute paths, not shell expansions.
ELAN_HOME=/srv/data/tauceti/elan
XDG_CACHE_HOME=/srv/data/tauceti/cache
UV_CACHE_DIR=/srv/data/tauceti/cache/uv
UV_PYTHON_INSTALL_DIR=/srv/data/tauceti/cache/uv-python
TMPDIR=/srv/data/tauceti/tmp
TAUCETI_LAKE_CACHE_ROOT=/srv/data/tauceti/cache/lake
TAUCETI_BUILD_CACHE_ROOT=/srv/data/tauceti/cache/builds
TAUCETI_SHARED_MATHLIB_ROOT=/srv/data/tauceti/cache/mathlib-builds
TAUCETI_VERIFY_CACHE_DIR=/srv/data/tauceti/cache/verification
TAUCETI_SHARED_MATHLIB_BUILDS=off
TAUCETI_SHARED_ARTIFACTS=0
TAUCETI_PRUNE_OBSOLETE_LEAN_TOOLCHAINS=false
TAUCETI_MIN_FREE_GIB=8
TAUCETI_LOG_RETENTION_DAYS=14
TAUCETI_LOG_MAX_MIB=256
