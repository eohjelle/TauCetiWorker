#!/usr/bin/env bash
# Run the changed-module environment lint from the matching TauCeti feature branch
# without requiring that branch to be installed in the target checkout.
set -euo pipefail

SOURCE="repos/eohjelle/TauCeti/contents/scripts/lint-env.sh?ref=codex%2Fnative-scoped-checks"

if ! repo_root=$(git rev-parse --show-toplevel); then
  echo "tauceti-lint-env: run this from a TauCeti checkout" >&2
  exit 2
fi
if [ ! -f "$repo_root/lakefile.toml" ] || [ ! -d "$repo_root/TauCeti" ]; then
  echo "tauceti-lint-env: $repo_root is not a TauCeti checkout" >&2
  exit 2
fi

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/tauceti-lint-env.XXXXXX")
cleanup() {
  rm -rf -- "$tmpdir"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

source_file="$tmpdir/lint-env.sh"
gh api -H "Accept: application/vnd.github.raw" "$SOURCE" >"$source_file"

# The upstream script locates the checkout through dirname($0). Give the sourced
# copy the same $0 it would have if it were installed as scripts/lint-env.sh.
cd "$repo_root"
bash -c 'source "$1" "${@:2}"' "$repo_root/scripts/lint-env.sh" "$source_file" "$@"
